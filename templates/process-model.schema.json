{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes BPMN Process Model",
  "type": "object",
  "required": [
    "process",
    "pools",
    "nodes",
    "flows"
  ],
  "properties": {
    "process": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "lanes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lanes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "pool",
          "lane"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "startEvent",
              "endEvent",
              "userTask",
              "serviceTask",
              "manualTask",
              "exclusiveGateway",
              "parallelGateway",
              "subProcess"
            ]
          },
          "name": {
            "type": "string"
          },
          "pool": {
            "type": "string"
          },
          "lane": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "sequence",
              "message"
            ]
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "waypoints": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "data_objects": {
      "type": "array"
    },
    "annotations": {
      "type": "array"
    },
    "stages": {
      "type": "array"
    },
    "brief": {
      "type": "object"
    },
    "style": {
      "type": "object"
    }
  }
}